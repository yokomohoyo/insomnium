<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration, slug "app-exe".
  Signs the Electron app executable from win-unpacked before
  release-on-publish.yml builds the installers around it.
  This copy is the reference; paste it into the SignPath project to change it.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Insomnium.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
