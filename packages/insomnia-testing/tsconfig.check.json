// for `npm run type-check` and ts-jest: not named tsconfig.json, so the bundlers
// that compile these files do not pick it up
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node", "jest"],
  },
  "include": [
    "src",
  ],
  // generated test files, compared as text
  "exclude": [
    "src/generate/fixtures",
  ],
}
