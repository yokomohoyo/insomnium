        "docs": "Everything about pets.",
        "meta": { "name": "Pets", "seq": 1 }
      },
      "items": [
        {
          "uid": "r2",
          "type": "http-request",
          "name": "Create pet",
          "seq": 2,
          "request": {
            "url": "{{host}}/{{version}}/pets",
            "method": "POST",
            "headers": [{ "uid": "h6", "name": "X-Request-Id", "value": "{{$guid}}", "enabled": true }],
            "params": [],
            "body": {
              "mode": "json",
              "json": "{\n  \"name\": \"{{name}}\",\n  \"species\": \"{{species}}\"\n}",
              "formUrlEncoded": [],
              "multipartForm": [],
              "file": []
            },
            "script": {},
            "vars": { "req": [{ "uid": "rv1", "name": "name", "value": "Tom", "enabled": true }, { "uid": "rv2", "name": "off", "value": "x", "enabled": false }] },
            "assertions": [],
            "tests": "",
            "docs": "",
            "auth": { "mode": "inherit" }
          }
        },
        {
          "uid": "r1",
          "type": "http-request",
          "name": "Get pet",
          "seq": 1,
          "settings": { "encodeUrl": false, "timeout": 5000, "followRedirects": false },
          "request": {
            "url": "{{host}}/pets/:id?expand=owner&fields=name",
            "method": "GET",
            "headers": [
              { "uid": "h4", "name": "X-Client", "value": "own", "enabled": true },
              { "uid": "h5", "name": "Accept", "value": "application/json", "enabled": false }
            ],
            "params": [
              { "uid": "p1", "name": "expand", "value": "owner", "type": "query", "enabled": true },
              { "uid": "p2", "name": "fields", "value": "name", "type": "query", "enabled": true },
              { "uid": "p3", "name": "debug", "value": "1", "type": "query", "enabled": false },
              { "uid": "p4", "name": "id", "value": "42", "type": "path", "enabled": true }
            ],
            "body": { "mode": "none", "formUrlEncoded": [], "multipartForm": [], "file": [] },
            "script": { "res": "bru.setVar('petId', res.body.id);" },
            "vars": { "res": [{ "uid": "rv3", "name": "petName", "value": "res.body.name", "enabled": true }] },
            "assertions": [
              { "uid": "a1", "name": "res.status", "value": "eq 200", "enabled": true },
              { "uid": "a2", "name": "res.status", "value": "200", "enabled": true },
              { "uid": "a3", "name": "res.body.name", "value": "eq \"Tom\"", "enabled": true },
              { "uid": "a4", "name": "res.body.tags[0]", "value": "isDefined", "enabled": false },
              { "uid": "a5", "name": "res.headers['content-type']", "value": "contains json", "enabled": true },
              { "uid": "a6", "name": "res.headers.etag", "value": "isUndefined", "enabled": true },
              { "uid": "a7", "name": "res.responseTime", "value": "lt 500", "enabled": true },
              { "uid": "a8", "name": "res.body", "value": "contains {{species}}", "enabled": true },
              { "uid": "a9", "name": "res.body.age", "value": "gte 1", "enabled": true },
              { "uid": "a10", "name": "res.body.name", "value": "matches ^T", "enabled": true },
              { "uid": "a11", "name": "req.body.name", "value": "isString", "enabled": false }
            ],
            "tests": "test('is a pet', () => expect(res.body).to.have.property('id'));",
            "docs": "Fetches one pet.",
            "auth": { "mode": "none" }
          }
        },
        {
          "uid": "f2",
          "type": "folder",
          "name": "Photos",
          "seq": 3,
          "items": [
            {
              "uid": "r3",
