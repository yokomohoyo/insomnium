                "params": [],
                "body": {
                  "mode": "multipartForm",
                  "formUrlEncoded": [],
                  "multipartForm": [
                    { "uid": "m1", "type": "text", "name": "caption", "value": "On the sofa", "enabled": true },
                    { "uid": "m2", "type": "file", "name": "photo", "value": ["/tmp/a.png", "/tmp/b.png"], "contentType": "image/png", "enabled": true },
                    { "uid": "m3", "type": "text", "name": "draft", "value": "yes", "enabled": false }
                  ],
                  "file": []
                },
                "auth": { "mode": "inherit" }
              }
