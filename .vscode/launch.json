{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: main",
      "type": "node",
      "request": "launch",
      "protocol": "inspector",
      "sourceMaps": true,
      "presentation": {
        "hidden": true,
        "group": "Insomnium",
        "order": 1
      },
      "cwd": "${workspaceFolder}/packages/insomnia",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": ["--remote-debugging-port=9222", "."],
      "outputCapture": "std",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "env": {
        "NODE_ENV": "development",
        "ELECTRON_IS_DEV": "1"
      }
    },
    {
      "name": "Electron: renderer",
      "type": "pwa-chrome",
      "request": "attach",
      "presentation": {
        "hidden": true,
        "group": "Insomnium",
        "order": 2
      },
      "port": 9222,
      "webRoot": "${workspaceFolder}/packages/insomnia/src",
      "timeout": 60000
    }
  ],
  "compounds": [
    {
      "name": "Insomnium",
      "presentation": {
        "hidden": false,
        "group": "Insomnium",
        "order": 0
      },
      "stopAll": true,
      "preLaunchTask": "Insomnium: Compile (Watch)",
      "configurations": ["Electron: main", "Electron: renderer"]
    }
  ]
}
